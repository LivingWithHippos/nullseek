<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uses ACCESS_NETWORK_STATE to check if the device is connected to internet or not -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Uses INTERNET to fetch RSS feed + images -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Uses ACCESS_LOCAL_NETWORK to connect to local media players like Kodi and VLC -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".MainApplication"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NullSeek">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NullSeek"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Magnet links clicked in browsers or other apps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="magnet" />
            </intent-filter>

            <!-- .torrent and .nzb files opened from file managers or downloads.
                 octet-stream is needed because many apps report torrents that way;
                 other files are rejected in code by extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-bittorrent" />
                <data android:mimeType="application/x-nzb" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Links shared from the browser or other apps (any hoster, magnets) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- .torrent and .nzb files shared from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/x-bittorrent" />
                <data android:mimeType="application/x-nzb" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TorboxDownloadsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_downloads_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/torbox_downloads_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TorboxQuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_actions_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/torbox_quick_actions_widget_info" />
        </receiver>
        <!-- keeps the in-app language choice on Android 12 and older -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>